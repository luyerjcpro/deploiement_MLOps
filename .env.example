'''
postgres (SRGBD) et psycopg (pilote de postgres) doivent être mentionnés
dans l'url de la base de données.
'''
# DATABASE_URL=postgresql+psycopg://user:motdepasse@localhost/nomdelabase

# POSTGRES_USER= user
# POSTGRES_PASSWORD= motdepasse
# POSTGRES_DB= nomdelabase

# SECRET_API_KEY= clefdesécurité

# TEST_DATABASE_URL=postgresql+psycopg://postgres:motdepasse@127.0.0.1:5432/nomdelabase_test